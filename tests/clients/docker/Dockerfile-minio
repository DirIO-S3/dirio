# MC_RELEASE: the recovered mc build published as ghcr.io/dirio-s3/test-mc
# (see the test-assets branch). dl.min.io no longer serves mc.
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z
FROM ghcr.io/dirio-s3/test-mc:${MC_RELEASE} AS mc

FROM alpine:3.24

# 1. Install dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    bash \
    jq

# 2. Copy the MinIO mc client from the recovered image
COPY --from=mc /usr/local/bin/mc /usr/local/bin/mc

# 3. Create a non-root user
RUN adduser -D -h /home/mcuser mcuser

# 4. Set working directory
WORKDIR /work
RUN chown mcuser:mcuser /work

# 5. Copy scripts and make them executable (must run as root before USER switch)
COPY lib/test_framework.sh ./lib/
COPY lib/validators.sh ./lib/
COPY scripts/mc.sh ./
COPY scripts/mc_admin.sh ./
RUN chmod +x mc.sh mc_admin.sh

# 6. Switch to the non-root user
USER mcuser

# 7. Set bash as the entrypoint
ENTRYPOINT ["/bin/bash"]